        ".agents/skills/accessibility-auditor/SKILL.md",
        ".agents/skills/frontend-testing/SKILL.md"
      ],
      "agents": [
        "frodo",
        "merry"
      ],
      "checks": [
        "npm run typecheck",
        "npm run test:frontend",
        "npm run build",
        "Browser: changed journeys, both themes, 320px/mobile/desktop, keyboard and reduced motion"
      ],
      "context": [
        "DESIGN.md",
        "coding-standards.md"
      ]
    },
    {
      "id": "backend",
      "match": [
        "backend/src/",
        "api/"
      ],
      "skills": [
        ".agents/skills/api-design/SKILL.md",
        ".agents/skills/backend-development/SKILL.md",
        ".agents/skills/multi-tenancy-architecture/SKILL.md",
        ".agents/skills/engineering-loop/code-inspection/SKILL.md"
      ],
      "agents": [
        "aragorn",
        "boromir",
        "merry"
      ],
      "checks": [
        "npm run typecheck",
        "npm test",
        "npm run build",
        "npm run test:integration"
      ],
      "context": [
        "architecture-blueprint.md",
        "coding-standards.md"
      ]
    },
    {
      "id": "database",
      "match": [
        "backend/prisma/"
      ],
      "skills": [
        ".agents/skills/database-principles/SKILL.md",
        ".agents/skills/prisma-drizzle-orm/SKILL.md",
        ".agents/skills/database-migration/SKILL.md",
        ".agents/skills/test-data-management/SKILL.md"
      ],
      "agents": [
        "aragorn",
        "boromir",
        "pippin"
      ],
      "checks": [
        "npm run typecheck",
        "npm test",
        "npm run build",
        "npm run test:integration"
      ],
      "context": [
        "architecture-blueprint.md",
        "coding-standards.md"
      ]
    },
    {
      "id": "authentication",
      "match": [
        "backend/src/middleware/auth.ts",
        "backend/src/controllers/authController.ts",
        "backend/src/lib/tenancy.ts",
        "frontend/src/auth/"
      ],
      "skills": [
        ".agents/skills/auth-architecture/SKILL.md",
        ".agents/skills/security-auditor/SKILL.md",
        ".agents/skills/multi-tenancy-architecture/SKILL.md"
      ],
      "agents": [
        "boromir",
        "pippin"
      ],
      "checks": [
        "npm run typecheck",
        "npm test",
        "npm run build",
        "npm run test:integration"
      ],
      "context": [
        "architecture-blueprint.md"
      ]
    },
    {
      "id": "tests",
      "match": [
        "backend/tests/",
        "scripts/sauron.test.cjs",
        "scripts/frontend-contracts.test.cjs",
        "scripts/verify-browser.cjs"
      ],
      "skills": [
        ".agents/skills/testing-principles/SKILL.md",
        ".agents/skills/test-data-management/SKILL.md"
      ],
      "agents": [
        "merry"
      ],
      "checks": [
        "npm test",
        "npm run test:workflow",
        "npm run test:frontend"
      ],
      "context": [
        "coding-standards.md"
      ]
    },
    {
      "id": "workflow",
      "match": [
        ".agents/",
        ".sauron/",
        ".codex/",
        ".cursor/",
        ".github/",
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md",
        ".cursorrules",
        "sauron.config.yaml",
        "sauron-skills.lock.json",
        "package.json",
        "package-lock.json",
        "scripts/sauron.cjs",
        "scripts/sauron.test.cjs"
      ],
      "skills": [
        ".agents/skills/arctic-workflow/SKILL.md",
        ".agents/skills/lean-code/SKILL.md"
      ],
      "agents": [
        "aragorn"
      ],
      "checks": [
        "npm run sauron:doctor",
        "npm run test:workflow"
      ],
      "context": [
        "sauron-workflow.md"
      ]
    },
    {
      "id": "delivery",
      "match": [
        "vercel.json",
        "railway.json",
        "docker-compose.yml",
        "scripts/deploy-vercel-migrations.cjs",
        "backend/package.json",
        "backend/package-lock.json",
        "frontend/package.json",
        "frontend/package-lock.json"
      ],
      "skills": [
        ".agents/skills/cicd-deployment/SKILL.md",
        ".agents/skills/security-auditor/SKILL.md"
      ],
      "agents": [
        "samwise",
        "boromir"
      ],
      "checks": [
        "npm run typecheck",
        "npm test",
        "npm run build"
      ],
      "context": [
        "architecture-blueprint.md",
        "coding-standards.md"
      ]
    }
  ],
